      "planner_cases": ["incomplete.audio-only-best", "incomplete.video-only-best", "incomplete.mixed-best", "expression.all-includes-storyboard", "multistream.default", "multistream.allow-video", "multistream.allow-audio", "multistream.allow-both", "multistream.duplicate-preserved"]
