      "selector_cases": ["coercion.numeric-id", "normalize.generated-missing", "normalize.sanitized", "normalize.duplicates", "normalize.extension-conflict"],
      "sorter_cases": ["default-order-full", "alias-resolution", "combined-field-limits", "numeric-string-mixed", "stable-complete-ties", "source-index-preservation", "sort-bounds-oversized"]
    },
    {
