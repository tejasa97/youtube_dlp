    },
    {
      "id": "readme-selector-examples",
      "selector_cases": ["operator.merge", "filter.chained", "filter.regex"],
      "planner_cases": ["quality.basic-best", "quality.basic-bv", "quality.basic-ba"]
    }
  ],
  "allowed_deviations": [
    "malformed.non-list",
    "malformed.non-object",
    "limit.format-count",
    "limit.id-bytes",
